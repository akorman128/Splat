NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 32 bytes, base64 — e.g. `openssl rand -base64 32`. Encrypts BYOK provider keys at rest.
APP_ENCRYPTION_KEY=

# Optional. Attribution headers sent with OpenRouter calls (HTTP-Referer /
# X-Title); OpenRouter credits traffic to your app on its public leaderboards.
# Unset is fine — requests work either way. Not a secret.
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=

# Optional. tldraw license key — removes the watermark on the canvas.
NEXT_PUBLIC_TLDRAW_KEY=
